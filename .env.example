# --- STT: ElevenLabs Scribe v2 ---
ELEVENLABS_API_KEY=
# Streaming (WS /v1/stt/stream) — ElevenLabs Realtime WebSocket API
STT_LIVE_MODEL=scribe_v2_realtime
# Seconds to wait after "end" for last segment before closing the turn
STT_LIVE_FINAL_TIMEOUT_SEC=3
# Batch (POST /v1/stt)
STT_MODEL=scribe_v2
# ISO-639-3 or ISO-639-1 language code (vie for Vietnamese, eng for English, empty for auto-detect)
STT_LANGUAGE_CODE=vie
STT_LANGUAGE_CODES=vi-VN
# smart = removes disfluencies and formats; verbatim = word for word
STT_MODE=smart
STT_TIMEOUT_SEC=60

# --- STT: which backend ---
# auto       = Gipformer local (if available), fallback to ElevenLabs Scribe
# gipformer  = always local Gipformer
# elevenlabs = always ElevenLabs Scribe
STT_BACKEND=elevenlabs

# --- STT: local Gipformer (STT_BACKEND=gipformer, or auto with model) ---
GIPFORMER_VERSION=1.5
GIPFORMER_QUANTIZE=fp32
GIPFORMER_DECODING_METHOD=modified_beam_search
GIPFORMER_NUM_THREADS=4
GIPFORMER_PRELOAD=true

# --- TTS: which backend ---
# auto       = VieNeu on an NVIDIA GPU (needs `uv sync --extra cuda`); no GPU -> ElevenLabs v4 Turbo
# vieneu     = always local VieNeu (TTS_DEVICE picks cpu/cuda)
# elevenlabs = always ElevenLabs v4 Turbo
TTS_BACKEND=elevenlabs

# --- TTS: ElevenLabs v4 Turbo (TTS_BACKEND=elevenlabs, or auto without GPU) ---
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# Prebuilt voice ID (default Nhu = A5w1fw5x0uXded1LDvZp, calm/confident Vietnamese female interviewer)
ELEVENLABS_TTS_VOICE=A5w1fw5x0uXded1LDvZp
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_48000
ELEVENLABS_TTS_SAMPLE_RATE=48000
ELEVENLABS_TTS_TIMEOUT_SEC=60

# --- TTS: local VieNeu (TTS_BACKEND=vieneu, or auto with GPU) ---
TTS_MODEL=vieneu-v3-turbo
TTS_VOICE=Trúc Ly
TTS_DEVICE=auto
TTS_CPU_PRECISION=fp32
TTS_CPU_THREADS=0
TTS_GPU_MAX_BATCH_SIZE=32
TTS_GPU_MAX_STREAMS=16
TTS_GPU_DTYPE=float32
TTS_PRELOAD=true
TTS_MAX_CHARS=2000
TTS_TEMPERATURE=0.8
TTS_TOP_K=25
TTS_TOP_P=0.95
TTS_REPETITION_PENALTY=1.2
TTS_APPLY_WATERMARK=false

# --- Docker build options ---
# BUILD_WITH_CUDA=false (mặc định nhẹ ~1.5GB, không kéo 14 gói CUDA 12)
# Đổi thành true nếu muốn build image kèm PyTorch CUDA GPU (~11GB)
BUILD_WITH_CUDA=false

# --- Service ---
SERVICE_TOKEN=
CORS_ORIGINS=*
