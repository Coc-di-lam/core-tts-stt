# --- STT: Gemini transcription ---
GEMINI_API_KEY=
# Streaming (WS /v1/stt/stream) — Live API
STT_LIVE_MODEL=gemini-3.5-transcribe-live
# Seconds to wait after "end" for Gemini's last segment before closing the turn
STT_LIVE_FINAL_TIMEOUT_SEC=3
# Batch (POST /v1/stt)
STT_MODEL=gemini-3.5-transcribe
# Comma-separated BCP-47 codes; leave empty for auto-detect / code-switching
STT_LANGUAGE_CODES=vi-VN
# smart = removes disfluencies and formats; verbatim = word for word
STT_MODE=smart
STT_TIMEOUT_SEC=60

# --- TTS: which backend ---
# auto   = VieNeu on an NVIDIA GPU (needs `uv sync --extra cuda`), max-quality settings below;
#          no GPU -> Gemini TTS (cloud, uses GEMINI_API_KEY)
# vieneu = always local VieNeu (TTS_DEVICE picks cpu/cuda)
# gemini = always Gemini TTS
TTS_BACKEND=auto

# --- TTS: Gemini (TTS_BACKEND=gemini, or auto without GPU) ---
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Prebuilt voice (default Leda = youthful female): Kore, Puck, Charon, Aoede, Leda, Orus, Zephyr, ... (GET /v1/tts/voices)
GEMINI_TTS_VOICE=Leda
# Optional delivery instruction for every clip, e.g. "calm, professional interviewer"
GEMINI_TTS_STYLE=young, warm and friendly female interviewer
GEMINI_TTS_TIMEOUT_SEC=60

# --- TTS: local VieNeu (TTS_BACKEND=vieneu, or auto with GPU) ---
# vieneu-v3-turbo (48 kHz, default) | vieneu-v3-nano (24 kHz, faster whole clips on weak CPUs, own voice list)
TTS_MODEL=vieneu-v3-turbo
TTS_VOICE=Trúc Ly
# auto = CUDA/PyTorch when torch sees an NVIDIA GPU (needs `uv sync --extra cuda`), else CPU/ONNX
# (with TTS_BACKEND=auto, VieNeu is only chosen on a GPU and always runs on cuda)
TTS_DEVICE=auto
# CPU only: int8 is ~1.5x faster than fp32 with the same intelligibility on VNNI CPUs
# (Intel Ice Lake+/Alder Lake+, AMD Zen 4+); use fp32 if int8 audio sounds distorted
TTS_CPU_PRECISION=int8
# CPU only: ONNX intra-op threads, 0 = engine default (~physical cores, max 8)
TTS_CPU_THREADS=0
# GPU only
TTS_GPU_MAX_BATCH_SIZE=32
TTS_GPU_MAX_STREAMS=16
# float32 = best quality (default) | bfloat16 / float16 = faster, less VRAM
TTS_GPU_DTYPE=float32
TTS_PRELOAD=true
TTS_MAX_CHARS=2000

# --- Service ---
# When set, /v1/* requires "Authorization: Bearer <SERVICE_TOKEN>"
SERVICE_TOKEN=
CORS_ORIGINS=*
